# Copy this file to ".env" and fill in values as needed.
# Phases 0-2 (setup, parsing, RAG) require NO keys — embeddings run locally.
# Only Phase 3 (chat) needs an LLM provider key.

# --- LLM provider selection -------------------------------------------------
# One of: gemini | openai | anthropic | ollama
AUDIT_LLM_PROVIDER=gemini

# --- Gemini (default, free tier) --------------------------------------------
# Get a free key at https://aistudio.google.com/app/apikey
AUDIT_GEMINI_API_KEY=
AUDIT_GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (optional) ------------------------------------------------------
AUDIT_OPENAI_API_KEY=
AUDIT_OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (optional) ---------------------------------------------------
AUDIT_ANTHROPIC_API_KEY=
AUDIT_ANTHROPIC_MODEL=claude-sonnet-5

# --- Ollama (optional, fully offline) ---------------------------------------
AUDIT_OLLAMA_BASE_URL=http://localhost:11434
AUDIT_OLLAMA_MODEL=llama3.1

# --- OCR fallback (optional) ------------------------------------------------
# Only needed for offline image OCR when no vision LLM is configured.
# Install Tesseract (winget install UB-Mannheim.TesseractOCR), then optionally
# set the full path to tesseract.exe if it is not on PATH.
AUDIT_TESSERACT_CMD=

# --- Embeddings -------------------------------------------------------------
# local (free, offline) | gemini | openai
AUDIT_EMBEDDING_BACKEND=local
AUDIT_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Behaviour --------------------------------------------------------------
AUDIT_LOG_LEVEL=INFO
AUDIT_MAX_UPLOAD_MB=50
AUDIT_CHUNK_SIZE=1000
AUDIT_CHUNK_OVERLAP=150
AUDIT_RETRIEVAL_TOP_K=5
